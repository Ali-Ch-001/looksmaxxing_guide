# ==============================================================================
# LOOKSMAXXING.GUIDE - Evidence-Led SEO Engine & Clinical Harm Reduction Pipeline
# Environment Configuration
# ==============================================================================

# Server & Runtime
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
DATABASE_PATH=state_store.db

# National Center for Biotechnology Information (NCBI) PubMed API
# Supplying an email is required by NCBI guidelines for Entrez E-Utilities
NCBI_EMAIL=team@looksmaxxing.guide
NCBI_API_KEY=

# LLM Providers (Optional for live generation; deterministic fallback included)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Langfuse Observability & LLM Tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# OpenTelemetry Distributed Tracing
OTEL_SERVICE_NAME=looksmaxxing-evidence-engine
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER=always_on
